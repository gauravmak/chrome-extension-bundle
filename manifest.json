{
  "manifest_version": 3,
  "name": "🧰 Chrome Toolbelt",
  "version": "2.0",
  "description": "Personal Chrome toolbelt — dark mode, GDPR cookie dismisser, focus mode (hide feeds + sidebars on YT/X/LinkedIn/FB/Reddit), auto-bounce distractions to your reading list, cookie editor, redirect tracer, live CSS editor, JS toggle, JSON formatter, picture-in-picture, Google Maps links, view image, save to reading material, copy page as markdown, Calendar quick actions, localhost jumper, color picker, fake form filler, settings backup.",
  "permissions": ["tabs", "storage", "cookies", "activeTab", "webRequest", "webNavigation", "contentSettings", "scripting", "bookmarks", "history"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "🧰 Chrome Toolbelt"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["logger.js", "darkmode.js", "nocookie.js", "livecss.js"],
    "run_at": "document_start"
  }, {
    "matches": ["<all_urls>"],
    "js": ["logger.js", "jsonformat.js"],
    "run_at": "document_end"
  }, {
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
    "js": ["logger.js", "unhook.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://x.com/*", "*://twitter.com/*", "*://mobile.x.com/*", "*://mobile.twitter.com/*"],
    "js": ["logger.js", "xunhook.js"],
    "run_at": "document_start"
  }, {
    "matches": [
      "*://*.linkedin.com/*",
      "*://x.com/*", "*://twitter.com/*", "*://mobile.x.com/*", "*://mobile.twitter.com/*",
      "*://*.facebook.com/*",
      "*://*.instagram.com/*",
      "*://*.reddit.com/*"
    ],
    "js": ["logger.js", "nfe.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.co.jp/*", "*://www.google.co.in/*", "*://www.google.co.kr/*", "*://www.google.co.id/*", "*://www.google.com.br/*", "*://www.google.com.au/*", "*://www.google.com.mx/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.pt/*", "*://www.google.pl/*", "*://www.google.se/*", "*://www.google.ca/*", "*://www.google.ru/*"],
    "js": ["logger.js", "gmaps.js"],
    "run_at": "document_end"
  }, {
    "matches": ["*://www.google.com/*", "*://www.google.co.uk/*", "*://www.google.co.jp/*", "*://www.google.co.in/*", "*://www.google.co.kr/*", "*://www.google.co.id/*", "*://www.google.com.br/*", "*://www.google.com.au/*", "*://www.google.com.mx/*", "*://www.google.de/*", "*://www.google.fr/*", "*://www.google.es/*", "*://www.google.it/*", "*://www.google.nl/*", "*://www.google.pt/*", "*://www.google.pl/*", "*://www.google.se/*", "*://www.google.ca/*", "*://www.google.ru/*"],
    "js": ["logger.js", "viewimage.js"],
    "run_at": "document_end"
  }, {
    "matches": ["*://teams.microsoft.com/*", "*://*.teams.microsoft.com/*", "*://teams.live.com/*", "*://*.teams.cloud.microsoft/*"],
    "js": ["logger.js", "teams.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://web.whatsapp.com/*"],
    "js": ["logger.js", "wasend.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
